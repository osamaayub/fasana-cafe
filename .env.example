# Database: Prisma Postgres connection string (prisma.io console > your database > Connect > copy DATABASE_URL)
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Admin login
ADMIN_EMAIL="admin@fasanacafe.pk"
ADMIN_PASSWORD="change-this-password"
# Long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-secret"

# Public site URL (used for SEO, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: "Continue with Google" (console.cloud.google.com > APIs & Services > Credentials > OAuth client ID, type Web application)
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: "Continue with Facebook" (developers.facebook.com > My Apps > Create app > Facebook Login)
# Valid OAuth Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Optional: email notifications for new reservations/messages via Resend (https://resend.com)
RESEND_API_KEY=""
NOTIFY_EMAIL_TO=""
NOTIFY_EMAIL_FROM="Fasana Website <onboarding@resend.dev>"

# Local testing only: print password-reset links to the server log when no email provider is set
LOG_RESET_LINKS=""
