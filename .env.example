# Database: Prisma Postgres connection string (prisma.io console > your database > Connect > copy DATABASE_URL)
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Admin login
ADMIN_EMAIL="admin@fasanacafe.pk"
ADMIN_PASSWORD="change-this-password"
# Long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-secret"

# Public site URL (used for SEO, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: "Continue with Google" (console.cloud.google.com > APIs & Services > Credentials > OAuth client ID, type Web application)
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: "Continue with GitHub" (github.com > Settings > Developer settings > OAuth Apps > New OAuth App)
# Authorization callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional: email. Guests get confirmations (booking received/confirmed/cancelled, message
# received, newsletter welcome) and staff get alerts. Configure ONE transport; with neither,
# no email is sent and the site still works.
#
# Option A, SMTP (works without a domain). Gmail: turn on 2-Step Verification, create an
# App Password at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=""          # e.g. smtp.gmail.com
SMTP_PORT="465"
SMTP_USER=""          # e.g. fasanacafe@gmail.com
SMTP_PASS=""
#
# Option B, Resend (https://resend.com). Needs a verified domain to email anyone except yourself.
RESEND_API_KEY=""
#
# Staff alerts go here (falls back to the cafe email in admin Settings)
NOTIFY_EMAIL_TO=""
# Sender shown to guests. With Gmail SMTP it must be the Gmail address itself.
NOTIFY_EMAIL_FROM=""

# Local testing only: print password-reset links to the server log when no email provider is set
LOG_RESET_LINKS=""
